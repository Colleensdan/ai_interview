# --- Azure OpenAI (use these OR the plain OpenAI key below, not both) ---
CJBS_API_ENDPOINT=https://your-resource.openai.azure.com/
CJBS_API_KEY=your_azure_key
CJBS_API_VERSION=2024-10-21

# --- Plain OpenAI (use this OR the Azure vars above, not both) ---
# OPENAI_API_KEY=your_openai_key

# Controls which model/deployment is used.
# Azure examples:  gpt-4o, gpt-4o-mini, gpt-4.1, gpt-5-mini  (must match your deployment name)
# OpenAI examples: gpt-4o, gpt-4o-mini, gpt-4.1
# Anthropic:       claude-3-5-sonnet-20240620, claude-3-haiku-20240307
CJBS_DEPLOYMENT_NAME=gpt-4o
CLIENT_ID=your_id
CLIENT_SECRET=your_id
PYTHON_VERSION=3.12.0
SP_HOSTNAME=sharepoint_url
SP_LIBRARY_NAME=folder_name
SP_SITE_PATH=folder_dir
SP_TARGET_FOLDER=incoming
TENANT_ID=your_id