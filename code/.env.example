# Set to false to use your personal OpenAI key instead of the CJBS Azure endpoint.
# Defaults to true if not set.
USE_AZURE=true

# --- Azure OpenAI (used when USE_AZURE=true) ---
CJBS_API_ENDPOINT=https://your-resource.openai.azure.com/
CJBS_API_KEY=your_azure_key
CJBS_API_VERSION=2024-10-21

# --- Plain OpenAI (used when USE_AZURE=false) ---
# OPENAI_API_KEY=your_personal_openai_key

# Model/deployment name.
# Azure: must match the deployment name in your Azure resource.
# OpenAI: any valid model ID (e.g. gpt-4o, gpt-4o-mini, gpt-4.1).
CJBS_DEPLOYMENT_NAME=gpt-4o

CLIENT_ID=your_id
CLIENT_SECRET=your_id
PYTHON_VERSION=3.12.0
SP_HOSTNAME=sharepoint_url
SP_LIBRARY_NAME=folder_name
SP_SITE_PATH=folder_dir
SP_TARGET_FOLDER=incoming
TENANT_ID=your_id
