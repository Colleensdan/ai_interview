CJBS_API_ENDPOINT=url
CJBS_API_KEY=your_key
CJBS_API_VERSION=2024-10-21 (date)
# Controls which model is used. Changing this is the ONLY thing needed to switch models.
# OpenAI/Azure examples: gpt-4o, gpt-4o-mini, gpt-4.1, gpt-5-mini
# Anthropic examples:    claude-3-5-sonnet-20240620, claude-3-haiku-20240307
CJBS_DEPLOYMENT_NAME=gpt-4o
CLIENT_ID=your_id
CLIENT_SECRET=your_id
PYTHON_VERSION=3.12.0
SP_HOSTNAME=sharepoint_url
SP_LIBRARY_NAME=folder_name
SP_SITE_PATH=folder_dir
SP_TARGET_FOLDER=incoming
TENANT_ID=your_id